# ─────────────────────────────────────────────────────────────────────────────
# Driver Alertness Detection — Environment Configuration
# Copy this file to .env and fill in real values before running.
# .env is git-ignored; this file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Flask ────────────────────────────────────────────────────────────────────
# "development" enables the debugger and auto-reloader.
# Set to "production" for all deployed environments.
FLASK_ENV=development

# A long, random string used for session signing.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploying

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ─── Model ────────────────────────────────────────────────────────────────────
# Path to the trained SimpleCNN weights file (.pt).
# After running `make train` this will be outputs/models/best_model.pt
MODEL_PATH=outputs/models/best_model.pt

# ─── Logging ──────────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Detection thresholds ─────────────────────────────────────────────────────
# Eye Aspect Ratio — frames where EAR < this value count as "eyes closed"
EAR_THRESHOLD=0.25

# Mouth Aspect Ratio — frames where MAR > this value count as a yawn
MAR_THRESHOLD=0.60

# PERCLOS — fraction of the rolling window that triggers a Drowsy alert
PERCLOS_THRESHOLD=0.80

# Rolling window length in frames used for PERCLOS and blink counting
PERCLOS_WINDOW=30
